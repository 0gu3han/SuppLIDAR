# MySQL (OCI Database Service)
DATABASE_URL=mysql+pymysql://<user>:<password>@<oci-mysql-host>:3306/supplidar

# OCI Auth
# Option A: config file (default — uses ~/.oci/config)
OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT

# Option B: env vars (for CI / OCI Compute instance principal)
# OCI_TENANCY_OCID=ocid1.tenancy.oc1..
# OCI_USER_OCID=ocid1.user.oc1..
# OCI_FINGERPRINT=aa:bb:cc:...
# OCI_KEY_FILE=~/.oci/oci_api_key.pem
# OCI_REGION=us-chicago-1

# OCI Compartment
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..

# OCI Object Storage
OCI_BUCKET_NAME=supplidar-files
OCI_NAMESPACE=<your-object-storage-namespace>
OCI_REGION=us-chicago-1

# OCI Gen AI endpoint (region-specific)
OCI_GENAI_ENDPOINT=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com

# Local dev fallback (skips OCI calls, saves files locally)
USE_LOCAL_STORAGE=true
PORT=5001
